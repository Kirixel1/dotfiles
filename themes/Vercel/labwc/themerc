# Vercel - labwc theme (Openbox 3.6 themerc format)
# Palette taken from your own Blender "palette" extension cache:
#   ~/.config/blender/5.2/extensions/.user/blender_org/palette/cache/gogh/Vercel.yml
#
# NO focus highlight: the active border is the same colour as the titlebar,
# so there is no visible ring around the focused window.

# --- Active (focused) window -----------------------------------------------
window.active.title.bg: flat solid
window.active.title.bg.color: #181818
window.active.label.text.color: #FAFAFA
window.active.label.text.font: sans-10

window.active.handle.width: 1
window.active.handle.color: #101010

# Same as the titlebar on purpose -> invisible, no focus ring
window.active.border.width: 1
window.active.border.color: #181818

window.active.button.unpressed.image.color: #A8A8A8
window.active.button.hover.image.color: #FAFAFA
window.active.button.hover.bg.color: #333333
window.active.button.pressed.image.color: #000000
window.active.button.pressed.bg.color: #333333
window.active.button.toggled.image.color: #A8A8A8
window.active.button.toggled.bg.color: #1A1A1A

# --- Inactive window ------------------------------------------------------
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #101010
window.inactive.label.text.color: #A8A8A8
window.inactive.label.text.font: sans-10

window.inactive.handle.width: 1
window.inactive.handle.color: #000000

# Same as its own titlebar -> also invisible
window.inactive.border.width: 1
window.inactive.border.color: #101010

window.inactive.button.unpressed.image.color: #4D4D4D
window.inactive.button.hover.image.color: #A8A8A8
window.inactive.button.hover.bg.color: #1A1A1A
window.inactive.button.pressed.image.color: #FAFAFA
window.inactive.button.pressed.bg.color: #1A1A1A
window.inactive.button.toggled.image.color: #4D4D4D
window.inactive.button.toggled.bg.color: #1A1A1A

# --- Menus ----------------------------------------------------------------
menu.title.bg: flat solid
menu.title.bg.color: #101010
menu.title.text.color: #FAFAFA
menu.title.text.font: sans-bold-10

menu.items.bg: flat solid
menu.items.bg.color: #181818
menu.items.text.color: #FAFAFA
menu.items.active.bg: flat solid
menu.items.active.bg.color: #333333
menu.items.active.text.color: #FFFFFF
menu.separator.color: #333333

# --- Client list (window switcher OSD) ------------------------------------
client-list.items.bg: flat solid
client-list.items.bg.color: #181818
client-list.items.text.color: #FAFAFA
client-list.items.active.bg: flat solid
client-list.items.active.bg.color: #333333
client-list.items.active.text.color: #FFFFFF

# --- Tooltips -------------------------------------------------------------
tooltip.bg: flat solid
tooltip.bg.color: #181818
tooltip.text.color: #FAFAFA

# --- OSD (alt+tab) --------------------------------------------------------
osd.bg: flat solid
osd.bg.color: #181818
osd.border.color: #333333
osd.label.bg: flat solid
osd.label.bg.color: #181818
osd.label.text.color: #FAFAFA